<Window
    x:Class="TinyUIFixApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyUIFixApp"
>
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
        <Grid x:Name="DragArea" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE740;" FontSize="14" Foreground="{StaticResource ApexAccentBrush}" />
                <TextBlock Text="{x:Bind local:L.T('app.title')}" FontSize="12" Foreground="{StaticResource ApexSoftTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
            <Button x:Name="LanguageButton" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="10,4"
                    AutomationProperties.Name="{x:Bind local:L.T('language')}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE774;" FontSize="13" />
                    <TextBlock x:Name="LanguageText" FontSize="12" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="LanguageMenu" Placement="BottomEdgeAlignedRight" />
                </Button.Flyout>
            </Button>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="264"
                        IsTitleBarAutoPaddingEnabled="False" SelectionChanged="OnNavSelection">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#D90B0C0E" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#1F2025" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind local:L.T('nav.size')}" Tag="0"><NavigationViewItem.Icon><FontIcon Glyph="&#xE740;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="{x:Bind local:L.T('nav.compat')}" Tag="1"><NavigationViewItem.Icon><FontIcon Glyph="&#xE74C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="{x:Bind local:L.T('nav.cursor')}" Tag="2"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B0;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{x:Bind local:L.T('nav.maintenance')}" Tag="3"><NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="{x:Bind local:L.T('nav.about')}" Tag="4"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <TextBlock x:Name="VersionText" Margin="16,4,0,12" Style="{StaticResource ApexMuted}" />
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="GameRunningInfo" Severity="Warning" IsClosable="False" Margin="32,16,32,0"
                         Title="{x:Bind local:L.T('running.title')}" Message="{x:Bind local:L.T('running.message')}" />

                <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="32,24,32,20">
                    <!-- like Windows Settings: readable line lengths on wide windows, left-aligned -->
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="Screens">

                        <!-- loading -->
                        <StackPanel x:Name="ScreenLoading" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,120,0,0">
                            <ProgressRing IsActive="True" Width="40" Height="40" />
                            <TextBlock Text="{x:Bind local:L.T('loading.title')}" Style="{StaticResource ApexStrong}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LoadingLine" Style="{StaticResource ApexMuted}" HorizontalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>

                        <!-- problem while loading -->
                        <StackPanel x:Name="ScreenProblem" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind local:L.T('problem.title')}" Style="{StaticResource ApexTitle}" />
                            <InfoBar x:Name="ProblemInfo" Severity="Error" IsOpen="True" IsClosable="False" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- when the game wasn't found, picking its folder is the way forward -->
                                <Button x:Name="ProblemPickGame" Style="{StaticResource AccentButtonStyle}" Click="OnBrowseGame" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        <TextBlock Text="{x:Bind local:L.T('size.otherFolder')}" />
                                    </StackPanel>
                                </Button>
                                <Button Content="{x:Bind local:L.T('problem.retry')}" Click="OnRetry" />
                            </StackPanel>
                            <TextBox x:Name="ProblemLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="260"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <!-- first install: welcome -->
                        <StackPanel x:Name="ScreenWelcome" Spacing="14" Visibility="Collapsed">
                            <Grid ColumnSpacing="20" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource ApexAccentBrush}">
                                    <FontIcon Glyph="&#xE740;" FontSize="32" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind local:L.T('welcome.title')}" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind local:L.T('welcome.subtitle')}"
                                               Foreground="{StaticResource ApexMutedBrush}" FontSize="14" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <local:WrapPanel Spacing="8">
                                <Border Style="{StaticResource ApexPill}" Padding="10,5" CornerRadius="13">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="{StaticResource ApexAccentBrush}" />
                                        <TextBlock x:Name="WelcomeGame" FontSize="12" Foreground="{StaticResource ApexSoftTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />
                                        <HyperlinkButton Content="{x:Bind local:L.T('size.otherFolder')}" Click="OnBrowseGame" FontSize="12" Padding="4,0" MinHeight="0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ApexPill}" Padding="10,5" CornerRadius="13">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="13" Foreground="{StaticResource ApexAccentBrush}" />
                                        <TextBlock x:Name="WelcomeScreen" FontSize="12" Foreground="{StaticResource ApexSoftTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ApexPill}" Padding="10,5" CornerRadius="13">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74C;" FontSize="13" Foreground="{StaticResource ApexAccentBrush}" />
                                        <TextBlock x:Name="WelcomeMods" FontSize="12" Foreground="{StaticResource ApexSoftTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </local:WrapPanel>

                            <Border Style="{StaticResource ApexCard}" Padding="20,18">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="170" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:L.T('welcome.suggested')}" Style="{StaticResource ApexMuted}" FontSize="13" />
                                        <TextBlock x:Name="WelcomeScale" FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource ApexAccentBrush}" />
                                        <TextBlock x:Name="WelcomeScaleWhy" Style="{StaticResource ApexBody}" Foreground="{StaticResource ApexSoftTextBrush}" />
                                        <TextBlock Text="{x:Bind local:L.T('welcome.changeLater')}" Style="{StaticResource ApexMuted}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnSpacing="14" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <Border x:Name="WelcomeBeforeFrame" CornerRadius="6" Background="Black" SizeChanged="OnWelcomeFrameResized">
                                                    <Grid>
                                                        <Image x:Name="WelcomeBeforeScene" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image x:Name="WelcomeBeforeHud" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="WelcomeBeforeCaption" Text="{x:Bind local:L.T('welcome.today')}" Style="{StaticResource ApexMuted}" HorizontalAlignment="Center" TextAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <Border x:Name="WelcomeAfterFrame" CornerRadius="6" Background="Black" SizeChanged="OnWelcomeFrameResized">
                                                    <Grid>
                                                        <Image x:Name="WelcomeAfterScene" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image x:Name="WelcomeAfterHud" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="WelcomeAfterCaption" Text="" Style="{StaticResource ApexMuted}" HorizontalAlignment="Center" TextAlignment="Center" />
                                            </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ApexCard}" Padding="16,14">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource ApexAccentBrush}">
                                                <TextBlock Text="1" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind local:L.T('nav.size')}" Style="{StaticResource ApexStrong}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind local:L.T('welcome.step1')}" Style="{StaticResource ApexMuted}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource ApexCard}" Padding="16,14">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource ApexAccentBrush}">
                                                <TextBlock Text="2" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind local:L.T('nav.compat')}" Style="{StaticResource ApexStrong}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind local:L.T('welcome.step2')}" Style="{StaticResource ApexMuted}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource ApexCard}" Padding="16,14">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource ApexAccentBrush}">
                                                <TextBlock Text="3" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind local:L.T('nav.cursor')}" Style="{StaticResource ApexStrong}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind local:L.T('welcome.step3')}" Style="{StaticResource ApexMuted}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{x:Bind local:L.T('welcome.footnote')}" Style="{StaticResource ApexMuted}" />
                        </StackPanel>

                        <!-- 0 Scale -->
                        <StackPanel x:Name="ScreenScale" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind local:L.T('size.title')}" Style="{StaticResource ApexTitle}" />
                            <TextBlock Text="{x:Bind local:L.T('size.subtitle')}" Style="{StaticResource ApexMuted}" FontSize="13" />

                            <Border Style="{StaticResource ApexCard}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ApexPillBrush}">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="{StaticResource ApexAccentBrush}" />
                                    </Border>
                                    <ComboBox x:Name="GamePicker" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              SelectionChanged="OnGamePicked" AutomationProperties.Name="{x:Bind local:L.T('size.install')}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:GameInstall">
                                                <StackPanel Spacing="1" Padding="0,2">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource ApexStrong}" FontSize="13" />
                                                    <TextBlock Text="{x:Bind Path}" Style="{StaticResource ApexMuted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="2" Click="OnBrowseGame" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                                            <TextBlock Text="{x:Bind local:L.T('size.otherFolder')}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ApexCard}" Padding="20,18">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScaleBig" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource ApexAccentBrush}" VerticalAlignment="Center" MinWidth="112" />
                                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="1" Maximum="3" StepFrequency="0.05" SmallChange="0.05" LargeChange="0.25"
                                                TickFrequency="0.5" TickPlacement="Outside" VerticalAlignment="Center" ValueChanged="OnScaleSlider"
                                                AutomationProperties.Name="{x:Bind local:L.T('size.title')}" />
                                        <NumberBox x:Name="ScaleBox" Grid.Column="2" Minimum="0.5" Maximum="5" SmallChange="0.05" LargeChange="0.25" Width="112"
                                                   SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="OnScaleBox"
                                                   AutomationProperties.Name="{x:Bind local:L.T('size.exact')}" />
                                    </Grid>
                                    <local:WrapPanel x:Name="Presets" Spacing="8" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ApexCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind local:L.T('size.preview')}" Style="{StaticResource ApexStrong}" FontSize="13" />
                                    <Border x:Name="PreviewFrame" CornerRadius="8" Background="Black" SizeChanged="OnPreviewResized">
                                        <Grid>
                                            <Image x:Name="PreviewScene" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="PreviewHud" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="PreviewCaption" Style="{StaticResource ApexMuted}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ApexCard}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ApexPillBrush}">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="18" Foreground="{StaticResource ApexAccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind local:L.T('size.textSame')}" Style="{StaticResource ApexStrong}" />
                                            <TextBlock Text="{x:Bind local:L.T('size.textSameHelp')}" Style="{StaticResource ApexMuted}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="TextSameToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="OnTextSame"
                                                      AutomationProperties.Name="{x:Bind local:L.T('size.textSame')}" />
                                    </Grid>
                                    <Grid x:Name="TextScaleRow" ColumnSpacing="16" Margin="50,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="TextSlider" Minimum="1" Maximum="3" StepFrequency="0.05" SmallChange="0.05" ValueChanged="OnTextSlider"
                                                VerticalAlignment="Center" AutomationProperties.Name="{x:Bind local:L.T('size.textSize')}" />
                                        <NumberBox x:Name="TextBox" Grid.Column="1" Minimum="0.5" Maximum="5" SmallChange="0.05" Width="112"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="OnTextBox" AutomationProperties.Name="{x:Bind local:L.T('size.textExact')}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 1 Compatibility -->
                        <StackPanel x:Name="ScreenPatches" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind local:L.T('nav.compat')}" Style="{StaticResource ApexTitle}" />
                            <TextBlock Text="{x:Bind local:L.T('compat.subtitle')}" Style="{StaticResource ApexMuted}" FontSize="13" />
                            <ItemsControl x:Name="PatchList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:PatchsetItem">
                                        <Border Style="{StaticResource ApexCard}">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ApexPillBrush}">
                                                        <FontIcon Glyph="&#xE74C;" FontSize="18" Foreground="{StaticResource ApexAccentBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ApexStrong}" />
                                                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource ApexMuted}" />
                                                        <TextBlock Text="{x:Bind Reason}" Style="{StaticResource ApexMuted}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind ReasonVisibility}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource ApexPill}">
                                                        <TextBlock Text="{x:Bind Pill}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                    <ToggleSwitch Grid.Column="3" OnContent="" OffContent="" MinWidth="0"
                                                                  IsOn="{x:Bind Enabled, Mode=TwoWay}" Visibility="{x:Bind ToggleVisibility}"
                                                                  AutomationProperties.Name="{x:Bind Name}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{x:Bind local:L.T('compat.order')}" Style="{StaticResource ApexStrong}" FontSize="13" Margin="0,8,0,0" />
                            <TextBlock Text="{x:Bind local:L.T('compat.orderHelp')}" Style="{StaticResource ApexMuted}" />
                            <Border Style="{StaticResource ApexCard}" Padding="6">
                                <ListView x:Name="OrderList" CanDragItems="True" CanReorderItems="True" AllowDrop="True" SelectionMode="None"
                                          DragItemsCompleted="OnOrderDragged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:PatchsetItem">
                                            <Grid ColumnSpacing="12" Padding="4,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE76F;" FontSize="14" Foreground="{StaticResource ApexMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource ApexBody}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Id}" Style="{StaticResource ApexMuted}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>

                        <!-- 2 Cursor and warnings -->
                        <StackPanel x:Name="ScreenCursor" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind local:L.T('nav.cursor')}" Style="{StaticResource ApexTitle}" />
                            <Border Style="{StaticResource ApexCard}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ApexPillBrush}">
                                            <FontIcon Glyph="&#xE8B0;" FontSize="18" Foreground="{StaticResource ApexAccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind local:L.T('cursor.size')}" Style="{StaticResource ApexStrong}" />
                                            <TextBlock Text="{x:Bind local:L.T('cursor.sizeHelp')}" Style="{StaticResource ApexMuted}" />
                                        </StackPanel>
                                        <NumberBox x:Name="CursorBox" Grid.Column="2" Minimum="0.5" Maximum="5" SmallChange="0.25" Width="112"
                                                   SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="OnAnySetting"
                                                   AutomationProperties.Name="{x:Bind local:L.T('cursor.size')}" />
                                    </Grid>
                                    <Grid ColumnSpacing="14" Margin="50,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind local:L.T('cursor.method')}" Style="{StaticResource ApexBody}" />
                                            <TextBlock Text="{x:Bind local:L.T('cursor.methodHelp')}" Style="{StaticResource ApexMuted}" />
                                        </StackPanel>
                                        <ComboBox x:Name="AlgorithmBox" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="OnAnySetting"
                                                  AutomationProperties.Name="{x:Bind local:L.T('cursor.methodName')}" />
                                    </Grid>
                                    <Grid ColumnSpacing="14" Margin="50,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind local:L.T('cursor.sharp')}" Style="{StaticResource ApexBody}" />
                                            <TextBlock Text="{x:Bind local:L.T('cursor.sharpHelp')}" Style="{StaticResource ApexMuted}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SharpToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAnySetting"
                                                      AutomationProperties.Name="{x:Bind local:L.T('cursor.sharp')}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ApexCard}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ApexPillBrush}">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{StaticResource ApexAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:L.T('cursor.warn')}" Style="{StaticResource ApexStrong}" />
                                        <TextBlock Text="{x:Bind local:L.T('cursor.warnHelp')}" Style="{StaticResource ApexMuted}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MismatchToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="OnAnySetting"
                                                  AutomationProperties.Name="{x:Bind local:L.T('cursor.warn')}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 3 Maintenance -->
                        <StackPanel x:Name="ScreenManage" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind local:L.T('nav.maintenance')}" Style="{StaticResource ApexTitle}" />
                            <Border Style="{StaticResource ApexCard}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ApexPillBrush}">
                                        <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="{StaticResource ApexAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:L.T('manage.updates')}" Style="{StaticResource ApexStrong}" />
                                        <TextBlock x:Name="UpdateText" Style="{StaticResource ApexMuted}" />
                                    </StackPanel>
                                    <Button x:Name="UpdateButton" Grid.Column="2" Content="{x:Bind local:L.T('manage.check')}" Click="OnCheckUpdates" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ApexCard}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ApexPillBrush}">
                                        <FontIcon Glyph="&#xE838;" FontSize="18" Foreground="{StaticResource ApexAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:L.T('manage.folder')}" Style="{StaticResource ApexStrong}" />
                                        <TextBlock x:Name="PackageText" Style="{StaticResource ApexMuted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{x:Bind local:L.T('manage.open')}" Click="OnOpenPackageFolder" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ApexCard}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ApexPillBrush}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{StaticResource ApexErrorBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:L.T('manage.uninstallTitle')}" Style="{StaticResource ApexStrong}" />
                                        <TextBlock Text="{x:Bind local:L.T('manage.uninstallHelp')}" Style="{StaticResource ApexMuted}" />
                                    </StackPanel>
                                    <Button x:Name="UninstallButton" Grid.Column="2" Content="{x:Bind local:L.T('manage.uninstall')}" Click="OnUninstall" />
                                </Grid>
                            </Border>
                            <InfoBar x:Name="ManageInfo" IsClosable="True" />
                        </StackPanel>

                        <!-- 4 About -->
                        <StackPanel x:Name="ScreenAbout" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind local:L.T('nav.about')}" Style="{StaticResource ApexTitle}" />
                            <Border Style="{StaticResource ApexCard}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind local:L.T('about.original')}" Style="{StaticResource ApexStrong}" />
                                    <TextBlock Text="{x:Bind local:L.T('about.originalBody')}" Style="{StaticResource ApexMuted}" FontSize="13" />
                                    <TextBlock Text="{x:Bind local:L.T('about.newUi')}" Style="{StaticResource ApexBody}" Foreground="{StaticResource ApexSoftTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <HyperlinkButton Content="{x:Bind local:L.T('about.forkPage')}" NavigateUri="https://github.com/loinyx/tiny-ui-fix-2" Padding="0" FontSize="12" />
                                        <HyperlinkButton Content="{x:Bind local:L.T('about.originalPage')}" NavigateUri="https://github.com/just-harry/tiny-ui-fix-for-ts3" Padding="0" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- generating -->
                        <StackPanel x:Name="ScreenWorking" Spacing="18" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind local:L.T('work.title')}" Style="{StaticResource ApexTitle}" />
                            <ProgressBar IsIndeterminate="True" />
                            <TextBlock x:Name="WorkingStep" Style="{StaticResource ApexBody}" Foreground="{StaticResource ApexSoftTextBrush}" />
                            <TextBlock Text="{x:Bind local:L.T('work.time')}" Style="{StaticResource ApexMuted}" />
                            <Expander Header="{x:Bind local:L.T('work.log')}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <TextBox x:Name="WorkingLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="220"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Expander>
                        </StackPanel>

                        <!-- done -->
                        <StackPanel x:Name="ScreenDone" Spacing="14" Visibility="Collapsed" HorizontalAlignment="Center" Padding="0,24,0,0">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#1A2A22" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{StaticResource ApexSuccessBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind local:L.T('done.title')}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DoneText" Style="{StaticResource ApexBody}" FontSize="14" Foreground="{StaticResource ApexSoftTextBrush}"
                                       TextAlignment="Center" MaxWidth="480" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button Content="{x:Bind local:L.T('done.back')}" Click="OnBackToSettings" />
                                <Button Content="{x:Bind local:L.T('done.close')}" Style="{StaticResource AccentButtonStyle}" Click="OnClose" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="24,0" ColumnSpacing="8" BorderBrush="#1F2025" BorderThickness="0,1,0,0" Background="#40000000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterNote" Style="{StaticResource ApexMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <Button x:Name="BackButton" Grid.Column="1" Content="{x:Bind local:L.T('footer.back')}" MinWidth="96" Click="OnBack" Visibility="Collapsed" />
                    <Button x:Name="GenerateButton" Grid.Column="2" MinWidth="148" Style="{StaticResource AccentButtonStyle}" Click="OnGenerate" IsEnabled="False"
                            AutomationProperties.Name="{x:Bind local:L.T('footer.generate')}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="GenerateIcon" Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Name="GenerateText" Text="{x:Bind local:L.T('footer.generate')}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
