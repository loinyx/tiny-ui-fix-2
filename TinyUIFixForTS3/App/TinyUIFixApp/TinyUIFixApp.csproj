<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TinyUIFixApp</RootNamespace>
    <AssemblyName>Tiny UI Fix 2</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- one exe next to the .bat: no MSIX, no runtime to install -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- trims the .NET framework and the Windows SDK projection; the app's own code and the WinRT/WinUI interop
         (found by reflection when collections are handed to WinUI) stay whole -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <Version>2.0.0</Version>
    <Product>Tiny UI Fix 2</Product>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="WinRT.Runtime" />
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
    <TrimmerRootAssembly Include="Microsoft.InteractiveExperiences.Projection" />
  </ItemGroup>
  <ItemGroup>
    <!-- the Windows App SDK's parts this app uses, without its AI, ML (onnxruntime, DirectML) and Widgets parts, about 40 MB it never loads -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="1.8.251216001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Strings\*.json" LogicalName="Strings.%(Filename).json" />
    <EmbeddedResource Include="Assets\preview_scene.jpg" LogicalName="preview_scene.jpg" />
    <EmbeddedResource Include="Assets\preview_hud.png" LogicalName="preview_hud.png" />
    <!-- the tool itself, so a download is one file; built by Building/Package-SingleFileDistributables.ps1 -->
    <EmbeddedResource Include="$(ToolBat)" LogicalName="tiny-ui-fix-for-ts3.bat" Condition="'$(ToolBat)' != '' And Exists('$(ToolBat)')" />
  </ItemGroup>
  <!-- The self-contained Windows App SDK runtime ships its AI, machine-learning (onnxruntime, DirectML) and Widgets
       parts too; this app never calls them, and they're loaded only when called, so they stay out of the exe (about 45 MB). -->
  <Target Name="LeaveOutUnusedWindowsAppSdkParts" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^(onnxruntime.*|DirectML\..*|Microsoft\.Windows\.AI(\..*)?\.(dll|winmd)|Microsoft\.Windows\.Widgets\..*)$', RegexOptions.IgnoreCase))" />
    </ItemGroup>
  </Target>
</Project>
